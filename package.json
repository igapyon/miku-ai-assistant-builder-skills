{
  "name": "miku-ai-assistant-builder-skills",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/skill-structure.test.mjs tests/conversion-job.test.mjs tests/md2xlsx-runtime.test.mjs",
    "verify:bundle": "node --test tests/isolated-bundle-smoke.test.mjs tests/release-bundle-contents.test.mjs",
    "build": "npm test && npm run build:bundle:zip && npm run verify:bundle",
    "build:bundle": "node scripts/build-skill-bundle.mjs",
    "build:bundle:zip": "node scripts/build-skill-bundle-zip.mjs",
    "verify:reproducible": "node scripts/check-reproducible-bundle.mjs"
  }
}
